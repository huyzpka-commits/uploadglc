# Copy this file to .env and fill in your credentials
# Required for OAuth login features

PORT=3000
SESSION_SECRET=your_super_secret_session_key_change_this

# Google OAuth (Google Drive / Google Account Login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft OAuth (OneDrive / Microsoft Account Login)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# Dropbox OAuth (Dropbox Account Login)
DROPBOX_CLIENT_ID=your_dropbox_app_key
DROPBOX_CLIENT_SECRET=your_dropbox_app_secret

# Base URL for OAuth callbacks (e.g. http://localhost:3000 or your production URL)
BASE_URL=http://localhost:3000
